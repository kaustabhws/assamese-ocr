{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/axomiya-layout-ocr/document.schema.json",
  "title": "Axomiya OCR document",
  "type": "object",
  "required": ["schema_version", "language", "pages", "metadata"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "language": { "const": "as" },
    "source": { "type": ["string", "null"] },
    "metadata": { "type": "object" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "width", "height", "regions"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "regions": {
            "type": "array",
            "items": { "$ref": "#/$defs/region" }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      }
    },
    "line": {
      "type": "object",
      "required": ["id", "bbox", "polygon", "text", "confidence", "order"],
      "properties": {
        "id": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "polygon": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "label", "bbox", "confidence", "order", "lines"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } }
      }
    }
  }
}

